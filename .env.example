# Optional. Increases the GitHub Search API rate limit.
GITHUB_TOKEN=

# Optional Unity Asset Store cache override.
# Windows example: C:\Users\you\AppData\Roaming\Unity\Asset Store-5.x
ASSETSTORE_CACHE_PATH=

# Optional Fafnir RAG tuning. Set both model values when overriding the pinned model.
FAFNIR_TEXT_EMBEDDING_MODEL=
FAFNIR_TEXT_EMBEDDING_REVISION=
FAFNIR_RAG_MIN_SIMILARITY=0.72
FAFNIR_ASSET_STORE_DETAIL_TTL_DAYS=30
